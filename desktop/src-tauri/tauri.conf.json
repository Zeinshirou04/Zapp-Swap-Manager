{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Zapp Swap Manager",
  "version": "0.3.3-beta.3",
  "identifier": "com.zapp.swapmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zapp Swap Manager",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Zapp Swap Manager",
    "copyright": "Copyright © 2026 Zapp Swap Manager Contributors",
    "category": "Utility",
    "shortDescription": "Fast game swapping and backup manager between SSD and HDD",
    "longDescription": "Zapp Swap Manager safely moves, organizes, and verifies Steam and PC game libraries between fast NVMe/SSD gaming drives and spacious storage drives, controlled locally or remotely from Android.",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/*"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "both",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "section": "games"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCOUQ3QjA3Q0E4QkMzMEYKUldRUHc0dktCM3VkTzhEYWNjUzdteFBqZVhmWHgvOXR2cjdmR3oyRFpNR1A0dFFLUnJMQ2ticlYK",
      "endpoints": [
        "https://github.com/Zeinshirou04/Zapp-Swap-Manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
