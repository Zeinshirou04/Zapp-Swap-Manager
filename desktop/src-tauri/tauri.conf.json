{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Zapp Swap Manager",
  "version": "0.1.0",
  "identifier": "com.zapp.swapmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zapp Swap Manager",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3MjQzN0YzQTE0Rjg2ODUKUldTRmhrK2g4emNrZDdyWlNSdEx6aURsRUJnL0U5UStXYmI4eFNsTGpOY2llb3ZNbzZibWVsajQK",
      "endpoints": [
        "https://github.com/Zeinshirou04/Zapp-Swap-Manager/releases/latest/download/latest.json"
      ]
    }
  }
}
